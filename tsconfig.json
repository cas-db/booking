{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@sap/cds": ["./node_modules/@cap-js/cds-types"]
    }
  },
  "include": ["srv/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
