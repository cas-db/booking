{
  "name": "cap-workshop-template",
  "version": "1.0.0",
  "description": "Workshop template: CAP 10 TypeScript hello world with all quality gates pre-wired",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cds serve",
    "watch": "cds watch",
    "demo": "./scripts/chain-demo.sh",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig app/tsconfig.json",
    "test": "node --env-file=test/.env --import tsx --test \"test/**/*.test.ts\" \"app/src/**/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "ui": "vite app",
    "build": "vite build app",
    "ui:build": "vite build app",
    "ui:preview": "vite preview app",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-types": "^0.19.0",
    "@playwright/test": "^1.62.1",
    "@sap/cds-dk": "^10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "oxlint": "^1",
    "prettier": "^3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5.9",
    "vite": "^8.2.2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "messaging": {
        "kind": "file-based-messaging",
        "[test]": {
          "kind": "local-messaging"
        }
      }
    },
    "folders": {
      "app": "app/dist"
    }
  }
}
